# Python bytecode and local environments.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Credentials and workstation-specific settings must never be published.
.env
.env.*
!.env.example
!.env.sample
.ssh/
.aws/
.azure/
.gitconfig
.netrc
_netrc
.pypirc
.npmrc
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials*.json
*service-account*.json
.idea/
.vscode/
.codex/
.claude/
/config/local/
/config/*.local.yaml
/config/*.local.yml
/config/*.private.yaml
/config/*.private.yml

# Keep test source; ignore only generated reports, downloaded data and caches.
/tests/data/
/tests/reports/
/tests/local/
/.smoke_cache/
/.test-tmp/
/.tmp/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Plans, test evidence and operational reports stay on the local machine.
plan/
plans/
reports/
test-results/
test-reports/
/tooling/diagnostics/
/tooling/workspace-maintenance/
PLAN.md
plan.md
*_plan.md
*_report.md
*测试报告*.md
*计划*.md

# Frozen workstation job: retain its bytes/path for production resume bindings.
/config/ecuador40_scl_companion.example.yaml

# Downloaded/generated products are not source code.
/outputs/
/data/
/_cache/
/logs/
*.log
*.tif
*.tiff
*.zarr/
*.parquet
